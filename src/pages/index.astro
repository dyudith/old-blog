---
export const prerender = false;
import { getPublishedProjects } from '../repositories/projects';
import { getPublishedPosts } from '../lib/blog';

const allPosts = await getPublishedPosts();
const latestPosts = allPosts.slice(0, 3);

// Si Supabase no está configurado, esto devuelve [] (ver repositories/projects.ts)
// y la sección de proyectos simplemente no se muestra — el resto de la home,
// que depende solo de MDX, no se ve afectado.
const allProjects = await getPublishedProjects();
const featuredProjects = allProjects.filter((p) => p.featured);
---

<BaseLayout title="Inicio">
  <section class="box">
    <h1>Hola, soy tu-nombre 👋</h1>
    <p>
      Este es mi rincón personal en internet. Acá escribo sobre programación,
      dejo constancia de proyectos y guardo cosas que no quiero perder.
      Reconstruido en 2026 con el espíritu de los sitios personales de hace
      veinte años, pero con herramientas de hoy.
    </p>
  </section>

  <section aria-labelledby="ultimos-posts-heading">
    <h2 id="ultimos-posts-heading">Últimas entradas</h2>
    <ul class="post-list">
      {latestPosts.map((post) => (
        <li class="box">
          <a href={`/blog/${post.id}`}>
            <h3>{post.data.title}</h3>
          </a>
          <p>{post.data.description}</p>
          <ul class="tag-list">
            {post.data.tags.map((tag) => <li class="badge">#{tag}</li>)}
          </ul>
        </li>
      ))}
    </ul>
    <p><a href="/blog">ver todas las entradas →</a></p>
  </section>

  <section aria-labelledby="proyectos-destacados-heading">
    <h2 id="proyectos-destacados-heading">Proyectos destacados</h2>
    {featuredProjects.length === 0 ? (
      <p><small style="color: var(--color-ink-soft);">(sin proyectos destacados por ahora)</small></p>
    ) : (
      <ul class="post-list">
        {featuredProjects.map((project) => (
          <li class="box">
            <a href={`/projects/${project.slug}`}>
              <h3>{project.name}</h3>
            </a>
            <p>{project.description}</p>
          </li>
        ))}
      </ul>
    )}
    <p><a href="/projects">ver todos los proyectos →</a></p>
  </section>
</BaseLayout>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .post-list h3 {
    margin: 0 0 var(--space-2);
    font-size: 1.05rem;
  }
  .post-list a {
    text-decoration: none;
  }
</style>
