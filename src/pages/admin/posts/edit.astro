---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getBlogPost, postBody } from '../../../lib/github-content';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');

const path = Astro.url.searchParams.get('path') ?? '';
const error = Astro.url.searchParams.get('error');

let post = null;
let loadError = '';

try {
  post = await getBlogPost(path);
} catch (err) {
  loadError = err instanceof Error ? err.message : 'No se pudo cargar el post.';
}
---

<BaseLayout title={post ? `Admin — Editar ${post.title}` : 'Admin — Editar post'} showSidebar={false}>
  <header class="page-header">
    <div>
      <p class="eyebrow">CMS / Blog</p>
      <h1>Editar post</h1>
      {post && (
        <p class:list={['status', post.draft ? 'draft' : 'published']}>
          {post.draft ? 'Borrador' : 'Publicado'}
        </p>
      )}
    </div>
    <a href="/admin/posts">← Posts</a>
  </header>

  {error && <p class="box error" role="alert">{error}</p>}
  {loadError && <p class="box error" role="alert">{loadError}</p>}

  {post && (
    <form class="box form" method="post" action="/api/admin/posts/update" enctype="multipart/form-data">
      <input type="hidden" name="path" value={post.path} />
      <input type="hidden" name="sha" value={post.sha} />
      <input type="hidden" name="currentDraft" value={post.draft ? 'true' : 'false'} />\n      <input type="hidden" name="existingCoverImage" value={post.coverImage} />

      <label>
        Título
        <input name="title" required maxlength="160" value={post.title} />
      </label>

      <label>
        Archivo
        <input value={post.path} readonly />
        <small>El slug/archivo se mantiene fijo para no romper la URL existente.</small>
      </label>

      <label>
        Descripción
        <textarea name="description" required maxlength="500" rows="3">{post.description}</textarea>
      </label>

      <label>
        Fecha
        <input name="date" type="date" required value={post.date} />
      </label>

      <label>
        Tags
        <input name="tags" value={post.tags.join(', ')} />
        <small>Separalos con comas.</small>
      </label>

      <label>
        Portada
        <input id="coverImage" name="coverImage" type="file" accept="image/jpeg,image/png,image/webp,image/avif" />
        <small>Opcional. Si no reemplazás la imagen, se conserva la actual. Máximo 6 MB.</small>
        <img id="coverPreview" class="cover-preview" src={post.coverImage || '/default-cover.svg'} alt={post.coverImageAlt || 'Vista previa de la portada'} />
      </label>

      <label>
        Alt de la imagen
        <input name="coverImageAlt" maxlength="200" value={post.coverImageAlt} />
      </label>

      <label>
        Contenido MDX
        <textarea class="editor" name="body" rows="28">{postBody(post)}</textarea>
      </label>

      <div class="form-actions">
        <button type="submit" name="action" value="save" class="secondary">Guardar cambios</button>
        {post.draft ? (
          <button type="submit" name="action" value="publish">Publicar</button>
        ) : (
          <button type="submit" name="action" value="unpublish" class="warning">Despublicar</button>
        )}
        <a href="/admin/posts">Cancelar</a>
      </div>
    </form>
  )}
</BaseLayout>

<style>
  .page-header { display:flex; justify-content:space-between; align-items:flex-start; gap:var(--space-4); padding-block:var(--space-5); }
  .eyebrow { margin:0 0 var(--space-2); font-family:var(--font-mono); font-size:.8rem; text-transform:uppercase; color:var(--color-ink-soft); }
  .status { margin:.4rem 0 0; font-family:var(--font-mono); font-size:.8rem; text-transform:uppercase; }
  .status.published { color:var(--color-online); }
  .status.draft { color:var(--color-ink-soft); }
  .error { border-color:#b34a4a; color:#8d2f2f; }
  .form { display:grid; gap:var(--space-4); max-width:900px; margin-inline:auto; }
  label { display:grid; gap:var(--space-2); font-family:var(--font-heading); font-weight:600; }
  input, textarea { width:100%; padding:.7rem .75rem; border:1px solid var(--color-border); border-radius:var(--radius-sm); background:var(--color-bg); color:var(--color-ink); font:inherit; }
  input[readonly] { opacity:.75; }
  small { color:var(--color-ink-soft); font-family:var(--font-body); font-weight:400; }
  .cover-preview { width:100%; max-width:720px; aspect-ratio:1200 / 630; object-fit:cover; border-radius:var(--radius-sm); border:1px solid var(--color-border); }\n  .editor { min-height:520px; font-family:var(--font-mono); line-height:1.55; resize:vertical; }
  .form-actions { display:flex; gap:var(--space-3); align-items:center; flex-wrap:wrap; }
  button { padding:.65rem 1rem; border:1px solid var(--color-accent-strong); border-radius:var(--radius-sm); background:var(--color-accent); color:white; font:inherit; cursor:pointer; }
  button.secondary { background:transparent; color:var(--color-accent); }
  button.warning { background:transparent; color:#8d2f2f; border-color:#b34a4a; }
</style>\n\n<script>\n  const input = document.querySelector<HTMLInputElement>("#coverImage");\n  const preview = document.querySelector<HTMLImageElement>("#coverPreview");\n  input?.addEventListener("change", () => {\n    const file = input.files?.[0];\n    if (!file || !preview) return;\n    preview.src = URL.createObjectURL(file);\n    preview.alt = `Vista previa de ${file.name}`;\n  });\n</script>
