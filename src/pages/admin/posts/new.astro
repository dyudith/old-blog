---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');

const error = Astro.url.searchParams.get('error');
const today = new Date().toISOString().slice(0, 10);
---

<BaseLayout title="Admin — Nuevo post" showSidebar={false}>
  <header class="page-header">
    <div>
      <p class="eyebrow">CMS / Blog</p>
      <h1>Nuevo post</h1>
    </div>
    <a href="/admin/posts">← Posts</a>
  </header>

  {error && <p class="box error" role="alert">{error}</p>}

  <form class="box form" method="post" action="/api/admin/posts/create" enctype="multipart/form-data">
    <label>
      Título
      <input name="title" required maxlength="160" />
    </label>

    <label>
      Slug
      <input name="slug" required maxlength="120" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="mi-nuevo-post" />
      <small>Se creará como <code>src/content/blog/slug.mdx</code>.</small>
    </label>

    <label>
      Descripción
      <textarea name="description" required maxlength="500" rows="3"></textarea>
    </label>

    <label>
      Fecha
      <input name="date" type="date" required value={today} />
    </label>

    <label>
      Tags
      <input name="tags" placeholder="astro, programación, notas" />
      <small>Separalos con comas.</small>
    </label>

    <label>
      Portada
      <input id="coverImage" name="coverImage" type="file" accept="image/jpeg,image/png,image/webp,image/avif" />
      <small>Opcional. Si no subís una imagen, se usará la portada predeterminada. Máximo 6 MB.</small>
      <img id="coverPreview" class="cover-preview" src="/default-cover.svg" alt="Vista previa de la portada predeterminada" />
    </label>

    <label>
      Alt de la imagen
      <input name="coverImageAlt" maxlength="200" />
    </label>

    <label>
      Contenido MDX
      <textarea class="editor" name="body" rows="28" placeholder="# Mi post&#10;&#10;Escribí el contenido en Markdown/MDX..."></textarea>
    </label>

    <div class="form-actions">
      <button type="submit" name="action" value="draft" class="secondary">Guardar borrador</button>
      <button type="submit" name="action" value="publish">Publicar</button>
      <a href="/admin/posts">Cancelar</a>
    </div>
  </form>
</BaseLayout>

<style>
  .page-header { display:flex; justify-content:space-between; align-items:center; gap:var(--space-4); padding-block:var(--space-5); }
  .eyebrow { margin:0 0 var(--space-2); font-family:var(--font-mono); font-size:.8rem; text-transform:uppercase; color:var(--color-ink-soft); }
  .error { border-color:#b34a4a; color:#8d2f2f; }
  .form { display:grid; gap:var(--space-4); max-width:900px; margin-inline:auto; }
  label { display:grid; gap:var(--space-2); font-family:var(--font-heading); font-weight:600; }
  input, textarea { width:100%; padding:.7rem .75rem; border:1px solid var(--color-border); border-radius:var(--radius-sm); background:var(--color-bg); color:var(--color-ink); font:inherit; }
  small { color:var(--color-ink-soft); font-family:var(--font-body); font-weight:400; }
  .cover-preview { width:100%; max-width:720px; aspect-ratio:1200 / 630; object-fit:cover; border-radius:var(--radius-sm); border:1px solid var(--color-border); }\n  .editor { min-height:520px; font-family:var(--font-mono); line-height:1.55; resize:vertical; }
  .form-actions { display:flex; gap:var(--space-3); align-items:center; flex-wrap:wrap; }
  button { padding:.65rem 1rem; border:1px solid var(--color-accent-strong); border-radius:var(--radius-sm); background:var(--color-accent); color:white; font:inherit; cursor:pointer; }
  button.secondary { background:transparent; color:var(--color-accent); }
  code { font-family:var(--font-mono); }
</style>\n\n<script>\n  const input = document.querySelector<HTMLInputElement>("#coverImage");\n  const preview = document.querySelector<HTMLImageElement>("#coverPreview");\n  input?.addEventListener("change", () => {\n    const file = input.files?.[0];\n    if (!file || !preview) return;\n    preview.src = URL.createObjectURL(file);\n    preview.alt = `Vista previa de ${file.name}`;\n  });\n</script>
