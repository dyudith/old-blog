---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { createSupabaseAdminClient } from '../../lib/supabase/admin';

const db = createSupabaseAdminClient();
const status = Astro.url.searchParams.get('status') ?? 'pending';
const error = Astro.url.searchParams.get('error');

const validStatuses = ['pending', 'approved', 'hidden'] as const;
const currentStatus = validStatuses.includes(status as typeof validStatuses[number])
  ? status
  : 'pending';

const { data: entries, error: listError } = await db
  .from('guestbook_entries')
  .select('*')
  .eq('status', currentStatus)
  .order('created_at', { ascending: false });

---

<BaseLayout title="Admin — Guestbook" showSidebar={false}>
  <header class="page-header">
    <div>
      <p class="eyebrow">CMS</p>
      <h1>Guestbook</h1>
      <p>Moderá los mensajes enviados por visitantes.</p>
    </div>
    <a href="/admin">← Admin</a>
  </header>

  <nav class="filters" aria-label="Estado de mensajes">
    {validStatuses.map((item) => (
      <a class:list={['filter', { active: currentStatus === item }]} href={`/admin/guestbook?status=${item}`}>
        {item === 'pending' ? 'Pendientes' : item === 'approved' ? 'Aprobados' : 'Ocultos'}
      </a>
    ))}
  </nav>

  {error && <p class="box error" role="alert">{error}</p>}
  {listError && <p class="box error" role="alert">{listError.message}</p>}

  {entries?.length ? (
    <div class="list">
      {entries.map((entry) => (
        <article class="box entry">
          <header>
            <div>
              <strong>{entry.name}</strong>
              {entry.website && <a href={entry.website} rel="nofollow noopener noreferrer">{entry.website}</a>}
            </div>
            <time datetime={entry.created_at}>{new Date(entry.created_at).toLocaleString('es-AR')}</time>
          </header>

          <p class="message">{entry.message}</p>

          <div class="actions">
            {currentStatus !== 'approved' && (
              <form method="post" action="/api/admin/cms/guestbook">
                <input type="hidden" name="_action" value="approve" />
                <input type="hidden" name="id" value={entry.id} />
                <button type="submit">Aprobar</button>
              </form>
            )}

            {currentStatus !== 'hidden' && (
              <form method="post" action="/api/admin/cms/guestbook">
                <input type="hidden" name="_action" value="hide" />
                <input type="hidden" name="id" value={entry.id} />
                <button type="submit">Ocultar</button>
              </form>
            )}

            <form method="post" action="/api/admin/cms/guestbook">
              <input type="hidden" name="_action" value="delete" />
              <input type="hidden" name="id" value={entry.id} />
              <button type="submit" class="danger" onclick="return confirm('¿Eliminar este mensaje?')">Eliminar</button>
            </form>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <p class="box empty">No hay mensajes en este estado.</p>
  )}
</BaseLayout>

<style>
  .page-header { display:flex; justify-content:space-between; align-items:flex-start; gap:var(--space-4); padding-block:var(--space-5); }
  .eyebrow { margin:0 0 var(--space-2); font-family:var(--font-mono); font-size:.8rem; text-transform:uppercase; color:var(--color-ink-soft); }
  .filters { display:flex; gap:.5rem; flex-wrap:wrap; margin-bottom:var(--space-4); }
  .filter { padding:.45rem .7rem; border:1px solid var(--color-border); border-radius:var(--radius-sm); color:var(--color-ink); text-decoration:none; }
  .filter.active { background:var(--color-bg-alt); }
  .list { display:grid; gap:var(--space-2); }
  .entry header { display:flex; justify-content:space-between; gap:var(--space-3); }
  .entry header > div { display:grid; gap:.25rem; }
  .entry header a { color:var(--color-ink-soft); font-size:.8rem; overflow-wrap:anywhere; }
  time { color:var(--color-ink-soft); font-family:var(--font-mono); font-size:.72rem; }
  .message { white-space:pre-wrap; }
  .actions { display:flex; gap:.5rem; flex-wrap:wrap; }
  .actions button { padding:.5rem .75rem; border:1px solid var(--color-border); border-radius:var(--radius-sm); background:var(--color-bg-alt); color:var(--color-ink); font:inherit; cursor:pointer; }
  .actions .danger { color:#8d2f2f; }
  .error { border-color:#b34a4a; color:#8d2f2f; }
  .empty { color:var(--color-ink-soft); }
  @media(max-width:700px) { .page-header { flex-direction:column; } .entry header { flex-direction:column; } }
</style>
