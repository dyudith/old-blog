---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createSupabaseAdminClient } from '../../lib/supabase/admin';
const db=createSupabaseAdminClient(); const editId=Astro.url.searchParams.get('edit'); const error=Astro.url.searchParams.get('error');
const {data:entries,error:listError}=await db.from('music_entries').select('*').order('listened_at',{ascending:false});
const {data:editing}=editId?await db.from('music_entries').select('*').eq('id',editId).maybeSingle():{data:null};
---
<BaseLayout title="Admin — Music" showSidebar={false}>
<p><a href="/admin">← Admin</a></p><h1>Music</h1><p>Gestioná canciones y qué aparece como “escuchando ahora”.</p>{error&&<p class="error">{error}</p>}{listError&&<p class="error">{listError.message}</p>}
<section class="box"><h2>{editing?'Editar entrada':'Nueva entrada'}</h2><form method="post" action="/api/admin/cms/music" class="form"><input type="hidden" name="_action" value="save"/>{editing&&<input type="hidden" name="id" value={editing.id}/>}<label>Artista<input name="artist" required value={editing?.artist??''}/></label><label>Canción<input name="track" value={editing?.track??''}/></label><label>Álbum<input name="album" value={editing?.album??''}/></label><label>Tipo<select name="kind"><option value="log" selected={editing?.kind==='log'}>Historial</option><option value="now_playing" selected={editing?.kind==='now_playing'}>Now playing</option></select></label><label>Escuchada<input name="listened_at" type="datetime-local" value={editing?.listened_at ? new Date(editing.listened_at).toISOString().slice(0,16) : ''}/></label><label class="check"><input type="checkbox" name="is_current" checked={editing?.is_current??false}/> Escuchando ahora</label><div class="actions"><button>Guardar</button>{editing&&<a href="/admin/music">Cancelar</a>}</div></form></section>
<h2>Entradas ({entries?.length??0})</h2><div class="list">{entries?.map(entry=><article class="box item"><div><strong>{entry.track||'Sin título'}</strong><small>{entry.artist} · {entry.is_current?'AHORA':'historial'}</small></div><div class="actions"><a href={`/admin/music?edit=${entry.id}`}>Editar</a><form method="post" action="/api/admin/cms/music"><input type="hidden" name="_action" value="delete"/><input type="hidden" name="id" value={entry.id}/><button onclick="return confirm('¿Eliminar esta entrada?')">Eliminar</button></form></div></article>)}</div>
</BaseLayout>
<style>.form{display:grid;gap:var(--space-3)}label{display:grid;gap:.35rem;font-weight:600}input,select{width:100%;padding:.65rem;border:1px solid var(--color-border);border-radius:var(--radius-sm);background:var(--color-bg);color:var(--color-ink);font:inherit}.check{display:flex;gap:.5rem;align-items:center}.check input{width:auto}.actions{display:flex;gap:.75rem;align-items:center}.actions button,.actions a{padding:.55rem .8rem;border:1px solid var(--color-border);border-radius:var(--radius-sm);background:var(--color-bg-alt);color:var(--color-ink);font:inherit;text-decoration:none;cursor:pointer}.list{display:grid;gap:var(--space-2)}.item{display:flex;justify-content:space-between;gap:var(--space-3);align-items:center}.item small{display:block;margin-top:.25rem}.error{padding:var(--space-2);border:1px solid #b34a4a;color:#8d2f2f}</style>