---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createSupabaseAdminClient } from '../../lib/supabase/admin';
const db=createSupabaseAdminClient(); const editId=Astro.url.searchParams.get('edit'); const error=Astro.url.searchParams.get('error');
const {data:links,error:listError}=await db.from('links').select('*').order('created_at',{ascending:false});
const {data:editing}=editId?await db.from('links').select('*').eq('id',editId).maybeSingle():{data:null};
---
<BaseLayout title="Admin — Links" showSidebar={false}>
<p><a href="/admin">← Admin</a></p><h1>Links</h1><p>Tu colección de sitios, personas y recursos.</p>{error&&<p class="error">{error}</p>}{listError&&<p class="error">{listError.message}</p>}
<section class="box"><h2>{editing?'Editar enlace':'Nuevo enlace'}</h2><form method="post" action="/api/admin/cms/links" class="form"><input type="hidden" name="_action" value="save"/>{editing&&<input type="hidden" name="id" value={editing.id}/>}<label>Nombre<input name="name" required value={editing?.name??''}/></label><label>URL<input name="url" type="url" required value={editing?.url??''}/></label><label>Categoría<input name="category" value={editing?.category??''}/></label><label>Descripción<input name="description" value={editing?.description??''}/></label><label>Imagen<input name="image" type="url" value={editing?.image??''}/></label><label class="check"><input type="checkbox" name="featured" checked={editing?.featured??false}/> Destacado</label><label class="check"><input type="checkbox" name="published" checked={editing?.published??true}/> Publicado</label><div class="actions"><button>Guardar</button>{editing&&<a href="/admin/links">Cancelar</a>}</div></form></section>
<h2>Enlaces ({links?.length??0})</h2><div class="list">{links?.map(link=><article class="box item"><div><strong>{link.name}</strong><small>{link.url} · {link.published?'publicado':'borrador'}</small></div><div class="actions"><a href={`/admin/links?edit=${link.id}`}>Editar</a><form method="post" action="/api/admin/cms/links"><input type="hidden" name="_action" value="delete"/><input type="hidden" name="id" value={link.id}/><button onclick="return confirm('¿Eliminar este enlace?')">Eliminar</button></form></div></article>)}</div>
</BaseLayout>
<style>.form{display:grid;gap:var(--space-3)}label{display:grid;gap:.35rem;font-weight:600}input{width:100%;padding:.65rem;border:1px solid var(--color-border);border-radius:var(--radius-sm);background:var(--color-bg);color:var(--color-ink);font:inherit}.check{display:flex;gap:.5rem;align-items:center}.check input{width:auto}.actions{display:flex;gap:.75rem;align-items:center}.actions button,.actions a{padding:.55rem .8rem;border:1px solid var(--color-border);border-radius:var(--radius-sm);background:var(--color-bg-alt);color:var(--color-ink);font:inherit;text-decoration:none;cursor:pointer}.list{display:grid;gap:var(--space-2)}.item{display:flex;justify-content:space-between;gap:var(--space-3);align-items:center}.item small{display:block;margin-top:.25rem}.error{padding:var(--space-2);border:1px solid #b34a4a;color:#8d2f2f}</style>