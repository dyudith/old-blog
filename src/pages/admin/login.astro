---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { createSupabaseServerClient } from '../../lib/supabase/server';

const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
const {
  data: { user },
} = await supabase.auth.getUser();

if (user) {
  return Astro.redirect('/admin');
}

const error = Astro.url.searchParams.get('error');
---

<BaseLayout title="Admin — iniciar sesión" showSidebar={false}>
  <section class="admin-auth box">
    <p class="eyebrow">área privada</p>
    <h1>Iniciar sesión</h1>
    <p>Acceso al panel de administración de este sitio.</p>

    {error && <p class="error" role="alert">{error}</p>}

    <form method="post" action="/api/admin/login">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="username" required />

      <label for="password">Contraseña</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required />

      <button type="submit">Entrar</button>
    </form>
  </section>
</BaseLayout>

<style>
  .admin-auth {
    max-width: 460px;
    margin: 4rem auto;
  }
  .eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  form {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  label {
    font-family: var(--font-heading);
    font-weight: 600;
  }
  input {
    width: 100%;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-ink);
    font: inherit;
    margin-bottom: var(--space-2);
  }
  button {
    width: fit-content;
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-accent-strong);
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: white;
    font: inherit;
    cursor: pointer;
  }
  .error {
    padding: var(--space-2) var(--space-3);
    border: 1px solid #b34a4a;
    color: #8d2f2f;
    background: color-mix(in srgb, #b34a4a 8%, transparent);
  }
</style>
