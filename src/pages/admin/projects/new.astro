---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { createSupabaseServerClient } from '../../../lib/supabase/server';

const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect('/admin/login');
}
---

<BaseLayout title="Admin — Nuevo proyecto" showSidebar={false}>
  <header class="page-header">
    <div>
      <p class="eyebrow">CMS / Projects</p>
      <h1>Nuevo proyecto</h1>
    </div>
    <a href="/admin/projects">← Projects</a>
  </header>

  <form class="box form" method="post" action="/api/admin/projects/create">
    <label>
      Nombre
      <input name="name" required maxlength="120" />
    </label>

    <label>
      Slug
      <input name="slug" required maxlength="120" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="mi-proyecto" />
      <small>Solo minúsculas, números y guiones.</small>
    </label>

    <label>
      Descripción corta
      <textarea name="description" required maxlength="500" rows="3"></textarea>
    </label>

    <label>
      Descripción larga
      <textarea name="long_description" rows="6"></textarea>
    </label>

    <label>
      Imagen
      <input name="image" type="url" placeholder="https://..." />
    </label>

    <label>
      Sitio
      <input name="url" type="url" placeholder="https://..." />
    </label>

    <label>
      GitHub
      <input name="github_url" type="url" placeholder="https://github.com/..." />
    </label>

    <label>
      Tecnologías
      <input name="technologies" placeholder="Astro, TypeScript, Supabase" />
      <small>Separalas con comas.</small>
    </label>

    <label>
      Estado
      <select name="status">
        <option value="idea">Idea</option>
        <option value="active">Activo</option>
        <option value="archived">Archivado</option>
      </select>
    </label>

    <label class="check"><input type="checkbox" name="featured" /> Proyecto destacado</label>
    <label class="check"><input type="checkbox" name="published" /> Publicar inmediatamente</label>

    <div class="form-actions">
      <button type="submit">Crear proyecto</button>
      <a href="/admin/projects">Cancelar</a>
    </div>
  </form>
</BaseLayout>

<style>
  .page-header { display:flex; justify-content:space-between; align-items:center; gap:var(--space-4); padding-block:var(--space-5); }
  .eyebrow { margin:0 0 var(--space-2); font-family:var(--font-mono); font-size:.8rem; text-transform:uppercase; color:var(--color-ink-soft); }
  .form { display:grid; gap:var(--space-4); max-width:760px; margin-inline:auto; }
  label { display:grid; gap:var(--space-2); font-family:var(--font-heading); font-weight:600; }
  input, textarea, select { width:100%; padding:.7rem .75rem; border:1px solid var(--color-border); border-radius:var(--radius-sm); background:var(--color-bg); color:var(--color-ink); font:inherit; }
  small { color:var(--color-ink-soft); font-family:var(--font-body); font-weight:400; }
  .check { display:flex; grid-template-columns:none; flex-direction:row; align-items:center; font-family:var(--font-body); font-weight:400; }
  .check input { width:auto; }
  .form-actions { display:flex; gap:var(--space-3); align-items:center; }
  button { padding:.65rem 1rem; border:1px solid var(--color-accent-strong); border-radius:var(--radius-sm); background:var(--color-accent); color:white; font:inherit; cursor:pointer; }
</style>
