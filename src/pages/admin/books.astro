---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createSupabaseAdminClient } from '../../lib/supabase/admin';
const db=createSupabaseAdminClient();
const editId=Astro.url.searchParams.get('edit'); const error=Astro.url.searchParams.get('error');
const {data:books,error:listError}=await db.from('books').select('*').order('created_at',{ascending:false});
const {data:editing}=editId?await db.from('books').select('*').eq('id',editId).maybeSingle():{data:null};
---
<BaseLayout title="Admin — Books" showSidebar={false}>
<p><a href="/admin">← Admin</a></p><h1>Books</h1>{error&&<p class="error">{error}</p>}{listError&&<p class="error">{listError.message}</p>}
<section class="box"><h2>{editing?'Editar libro':'Nuevo libro'}</h2><form method="post" action="/api/admin/cms/books" class="form"><input type="hidden" name="_action" value="save"/>{editing&&<input type="hidden" name="id" value={editing.id}/>}<label>Título<input name="title" required value={editing?.title??''}/></label><label>Autor<input name="author" required value={editing?.author??''}/></label><label>Portada<input name="cover_image" type="url" value={editing?.cover_image??''}/></label><label>Estado<select name="status"><option value="to_read" selected={editing?.status==='to_read'}>Por leer</option><option value="reading" selected={editing?.status==='reading'}>Leyendo</option><option value="finished" selected={editing?.status==='finished'}>Terminado</option><option value="abandoned" selected={editing?.status==='abandoned'}>Abandonado</option></select></label><label>Comenzado<input name="started_at" type="date" value={editing?.started_at??''}/></label><label>Terminado<input name="finished_at" type="date" value={editing?.finished_at??''}/></label><label>Rating (1–5)<input name="rating" type="number" min="1" max="5" value={editing?.rating??''}/></label><label>Notas<textarea name="notes">{editing?.notes??''}</textarea></label><label class="check"><input type="checkbox" name="published" checked={editing?.published??true}/> Publicado</label><div class="actions"><button>Guardar</button>{editing&&<a href="/admin/books">Cancelar</a>}</div></form></section>
<h2>Libros ({books?.length??0})</h2><div class="list">{books?.map(book=><article class="box item"><div><strong>{book.title}</strong><small>{book.author} · {book.status}</small></div><div class="actions"><a href={`/admin/books?edit=${book.id}`}>Editar</a><form method="post" action="/api/admin/cms/books"><input type="hidden" name="_action" value="delete"/><input type="hidden" name="id" value={book.id}/><button onclick="return confirm('¿Eliminar este libro?')">Eliminar</button></form></div></article>)}</div>
</BaseLayout>
<style>.form{display:grid;gap:var(--space-3)}label{display:grid;gap:.35rem;font-weight:600}input,textarea,select{width:100%;padding:.65rem;border:1px solid var(--color-border);border-radius:var(--radius-sm);background:var(--color-bg);color:var(--color-ink);font:inherit}textarea{min-height:110px}.check{display:flex;gap:.5rem;align-items:center}.check input{width:auto}.actions{display:flex;gap:.75rem;align-items:center}.actions button,.actions a{padding:.55rem .8rem;border:1px solid var(--color-border);border-radius:var(--radius-sm);background:var(--color-bg-alt);color:var(--color-ink);font:inherit;text-decoration:none;cursor:pointer}.list{display:grid;gap:var(--space-2)}.item{display:flex;justify-content:space-between;gap:var(--space-3);align-items:center}.item small{display:block;margin-top:.25rem}.error{padding:var(--space-2);border:1px solid #b34a4a;color:#8d2f2f}</style>