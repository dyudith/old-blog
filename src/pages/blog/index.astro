---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../lib/mock-data';

const sorted = [...posts].sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout title="Blog" description="Entradas sobre programación y notas personales.">
  <h1>Blog</h1>
  <ul class="post-list">
    {sorted.map((post) => (
      <li class="box">
        <a href={`/blog/${post.slug}`}>
          <h2>{post.title}</h2>
        </a>
        <p><time datetime={post.date}>{post.date}</time></p>
        <p>{post.description}</p>
        <ul class="tag-list">
          {post.tags.map((tag) => <li class="badge">#{tag}</li>)}
        </ul>
      </li>
    ))}
  </ul>
  <!-- Fase 2: acá se agregará un link a /rss.xml -->
</BaseLayout>

<style>
  .post-list { list-style: none; padding: 0; display: grid; gap: var(--space-3); }
  .post-list h2 { margin: 0 0 var(--space-2); font-size: 1.1rem; }
  .post-list a { text-decoration: none; }
</style>
