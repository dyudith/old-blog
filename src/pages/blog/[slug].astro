---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import {
  getPublishedPosts,
  getAdjacentPosts,
  getRelatedPosts,
} from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);
const { previous, next } = getAdjacentPosts(allPosts, post.id);
const related = getRelatedPosts(allPosts, post, 3);
const coverImage = post.data.coverImage ?? '/default-cover.svg';
const coverImageAlt = post.data.coverImageAlt ?? 'Portada predeterminada de OldBlog';
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedDate={post.data.date}
  image={coverImage}
  imageAlt={coverImageAlt}
>
  <article class="box">
    <header>
      <h1>{post.data.title}</h1>
      <p>
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('es-AR', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </p>
      <ul class="tag-list">
        {post.data.tags.map((tag) => (
          <li><a class="badge" href={`/blog/tags/${tag}`}>#{tag}</a></li>
        ))}
      </ul>
    </header>

    <img
      src={coverImage}
      alt={coverImageAlt}
      width="1200"
      height="630"
      class="cover"
    />

    <div class="prose">
      <Content />
    </div>
  </article>

  <nav class="post-nav" aria-label="Navegación entre posts">
    <div>
      {previous && <a href={`/blog/${previous.id}`}>← {previous.data.title}</a>}
    </div>
    <div style="text-align: right;">
      {next && <a href={`/blog/${next.id}`}>{next.data.title} →</a>}
    </div>
  </nav>

  {related.length > 0 && (
    <section aria-labelledby="relacionados-heading">
      <h2 id="relacionados-heading">Posts relacionados</h2>
      <ul class="tag-list" style="flex-direction: column; align-items: flex-start; gap: var(--space-2);">
        {related.map((r) => (
          <li><a href={`/blog/${r.id}`}>{r.data.title}</a></li>
        ))}
      </ul>
    </section>
  )}

  <p><a href="/blog">← volver al blog</a></p>
</BaseLayout>

<style>
  .cover { display:block; width:100%; max-height:630px; object-fit:cover; border-radius:var(--radius-md); margin-block:var(--space-4); }
  .prose { max-width: 68ch; }
  .prose :global(h2) { margin-top: var(--space-5); }
  .prose :global(h3) { margin-top: var(--space-4); }
  .prose :global(p) { margin-block: var(--space-3); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3em; }
  .prose :global(blockquote) { margin: var(--space-4) 0; padding-left: var(--space-3); border-left: 3px solid var(--color-border); color: var(--color-ink-soft); font-style: italic; }
  .prose :global(pre) { padding: var(--space-3); border-radius: var(--radius-sm); overflow-x: auto; font-size: 0.9rem; }
  .prose :global(code) { font-family: var(--font-mono); }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin-block: var(--space-4); }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--color-border); padding: var(--space-2); text-align: left; }
  .post-nav { display:grid; grid-template-columns:1fr 1fr; gap:var(--space-3); margin-block:var(--space-5); padding-top:var(--space-3); border-top:1px dashed var(--color-border); }
</style>
