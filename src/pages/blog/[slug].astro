---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../lib/mock-data';

// Fase 1: generamos las rutas estáticas a partir del mock.
// Fase 2: esto se reemplaza por getStaticPaths() sobre la Content Collection
// de MDX (getCollection('blog')), y <slot /> pasa a renderizar <Content />.
export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<BaseLayout title={post.title} description={post.description}>
  <article class="box">
    <header>
      <h1>{post.title}</h1>
      <p><time datetime={post.date}>{post.date}</time></p>
      <ul class="tag-list">
        {post.tags.map((tag: string) => <li class="badge">#{tag}</li>)}
      </ul>
    </header>
    <hr />
    <p>
      (Contenido de ejemplo — Fase 1.) Acá va el cuerpo del post. A partir de
      la Fase 2, este contenido va a venir de un archivo <code>.mdx</code> en
      <code>src/content/blog/{post.slug}.mdx</code>, lo que va a permitir
      escribir en Markdown e insertar componentes interactivos dentro del
      texto.
    </p>
  </article>
  <p><a href="/blog">← volver al blog</a></p>
</BaseLayout>
