---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublishedPosts, getAllTags } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getAllTags(posts);
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)), tag },
  }));
}

const { posts, tag } = Astro.props;
---

<BaseLayout title={`Tag: ${tag}`} description={`Posts etiquetados con ${tag}.`}>
  <h1>#{tag}</h1>
  <ul class="post-list">
    {posts.map((post) => (
      <li class="box">
        <a href={`/blog/${post.id}`}><h2>{post.data.title}</h2></a>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
  <p><a href="/blog/tags">← ver todos los tags</a></p>
</BaseLayout>

<style>
  .post-list { list-style: none; padding: 0; display: grid; gap: var(--space-3); }
  .post-list h2 { margin: 0 0 var(--space-2); font-size: 1.1rem; }
  .post-list a { text-decoration: none; }
</style>
