---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublishedPosts, getAllTags } from '../../../lib/blog';

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
---

<BaseLayout title="Tags" description="Todos los tags usados en el blog.">
  <h1>Tags</h1>
  <ul class="tag-list">
    {tags.map(({ tag, count }) => (
      <li>
        <a class="badge" href={`/blog/tags/${tag}`}>#{tag} ({count})</a>
      </li>
    ))}
  </ul>
</BaseLayout>
