---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjectBySlug } from '../../repositories/projects';

const slug = Astro.params.slug;
const project = slug ? await getProjectBySlug(slug) : null;

if (!project) {
  Astro.response.status = 404;
}
---

<BaseLayout
  title={project ? project.name : 'Proyecto no encontrado'}
  description={project?.description ?? 'El proyecto solicitado no existe.'}
  image={project?.image ?? undefined}
>
  {project ? (
    <>
      <article class="box">
        <h1>{project.name}</h1>
        <p>{project.description}</p>
        {project.long_description && <p>{project.long_description}</p>}
        <ul class="tag-list">
          {project.technologies.map((tech) => <li class="badge">{tech}</li>)}
        </ul>
        <p>
          {project.url && <a href={project.url} rel="noopener noreferrer">sitio →</a>}
          {project.github_url && <> · <a href={project.github_url} rel="noopener noreferrer">código →</a></>}
        </p>
      </article>
      <p><a href="/projects">← volver a proyectos</a></p>
    </>
  ) : (
    <article class="box">
      <h1>Proyecto no encontrado</h1>
      <p>El proyecto solicitado no existe o ya no está publicado.</p>
      <p><a href="/projects">← volver a proyectos</a></p>
    </article>
  )}
</BaseLayout>
