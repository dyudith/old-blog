---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../lib/mock-data';

// Fase 3: reemplazado por una consulta a la tabla `projects` en Supabase
// (con prerender = false o generación en build según volumen de datos).
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<BaseLayout title={project.name} description={project.description}>
  <article class="box">
    <h1>{project.name}</h1>
    <p>{project.description}</p>
    <ul class="tag-list">
      {project.technologies.map((tech: string) => <li class="badge">{tech}</li>)}
    </ul>
    <p>
      {project.url && <a href={project.url} rel="noopener noreferrer">sitio →</a>}
      {project.githubUrl && <> · <a href={project.githubUrl} rel="noopener noreferrer">código →</a></>}
    </p>
  </article>
  <p><a href="/projects">← volver a proyectos</a></p>
</BaseLayout>
