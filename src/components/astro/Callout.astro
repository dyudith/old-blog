---
interface Props {
  type?: 'info' | 'warning' | 'success';
}
const { type = 'info' } = Astro.props;

const labels: Record<string, string> = {
  info: 'nota',
  warning: 'atención',
  success: 'listo',
};
---

<aside class={`callout callout--${type}`} role="note">
  <span class="callout__label">{labels[type]}</span>
  <div class="callout__body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    border: 1px solid var(--color-border);
    border-left-width: 4px;
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    margin: var(--space-4) 0;
    background: var(--color-bg);
  }
  .callout--info { border-left-color: var(--color-accent); }
  .callout--warning { border-left-color: #b58a2a; }
  .callout--success { border-left-color: var(--color-online); }

  .callout__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-soft);
    white-space: nowrap;
    padding-top: 0.2em;
  }
  .callout__body :global(p:first-child) { margin-top: 0; }
  .callout__body :global(p:last-child) { margin-bottom: 0; }
</style>
