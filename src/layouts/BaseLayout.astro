---
import '../styles/global.css';
import SiteHeader from '../components/astro/SiteHeader.astro';
import SiteFooter from '../components/astro/SiteFooter.astro';
import Sidebar from '../components/astro/Sidebar.astro';

interface Props {
  title: string;
  description?: string;
  /** false para páginas que no necesitan la sidebar (ej. la home puede definir su propio grid) */
  showSidebar?: boolean;
  /** 'article' activa meta de Open Graph específicas de post + JSON-LD BlogPosting */
  type?: 'website' | 'article';
  publishedDate?: Date;
  /** URL absoluta de la imagen destacada, si existe */
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description = 'Un rincón personal en internet: notas, proyectos y cosas que estoy leyendo o escuchando.',
  showSidebar = true,
  type = 'website',
  publishedDate,
  image,
  imageAlt,
} = Astro.props;

const absoluteImage = image ? new URL(image, Astro.site) : undefined;

const structuredData =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        datePublished: publishedDate?.toISOString(),
        image: absoluteImage?.toString(),
      }
    : undefined;

const pageTitle = title === 'Inicio' ? title + ' — mi sitio' : `${title} — mi sitio`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {type === 'article' && publishedDate && (
      <meta property="article:published_time" content={publishedDate.toISOString()} />
    )}

    <!-- Twitter / X -->
    <meta name="twitter:card" content={absoluteImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}

    <link rel="alternate" type="application/rss+xml" title="RSS del blog" href="/rss.xml" />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body>
    <a href="#contenido-principal" class="skip-link">Saltar al contenido principal</a>
    <SiteHeader />

    <div class="site-shell">
      {showSidebar ? (
        <div class="site-grid">
          <main id="contenido-principal" data-pagefind-body>
            <slot />
          </main>
          <Sidebar />
        </div>
      ) : (
        <main id="contenido-principal" data-pagefind-body style="padding-block: var(--space-5);">
          <slot />
        </main>
      )}
    </div>

    <SiteFooter />
  </body>
</html>
