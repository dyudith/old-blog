# Copiar a .env y completar con los valores reales del proyecto de Supabase.
# .env NO se sube al repo (ver .gitignore).

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key

# Token server-only usado por el CMS de Posts para leer/escribir archivos MDX
# mediante la GitHub Contents API. Nunca usarlo con PUBLIC_ ni exponerlo al cliente.
GITHUB_TOKEN=tu-github-token
GITHUB_REPOSITORY=dyudith/old-blog
GITHUB_BRANCH=main
