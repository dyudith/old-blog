# Copiar a .env y completar con los valores reales del proyecto de Supabase
# (Project Settings > API en el dashboard de Supabase).
# .env NO se sube al repo (ver .gitignore).

# URL pública del proyecto. Segura de exponer.
SUPABASE_URL=https://tu-proyecto.supabase.co

# "anon" key: pensada para ser pública. La seguridad real la da RLS, no el
# secreto de esta key. Se usa en las páginas que leen datos públicos.
SUPABASE_ANON_KEY=tu-anon-key

# "service_role" key: NUNCA exponer al navegador ni usarla en código que se
# ejecute en el cliente. Todavía no se usa en el proyecto (se reserva para
# el CMS/admin de la Fase 4, en endpoints server-only).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
